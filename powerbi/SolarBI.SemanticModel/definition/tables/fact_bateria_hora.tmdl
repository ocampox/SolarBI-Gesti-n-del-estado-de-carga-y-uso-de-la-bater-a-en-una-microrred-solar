table fact_bateria_hora
	lineageTag: 3ec478b5-fbba-43ac-8544-7061e6ae0d44

	measure 'SoC Prom %' = DIVIDE(SUMX(fact_bateria_hora, fact_bateria_hora[soc_prom] * fact_bateria_hora[seg_obs]), SUM(fact_bateria_hora[seg_obs]))
		formatString: 0.0
		lineageTag: 4767552c-09e5-4b42-a908-de7cdbe6fefa

	measure 'SoC Min %' = MIN(fact_bateria_hora[soc_min])
		formatString: 0.0
		lineageTag: af101d53-d5a7-4666-bf62-31e60d3ccdef

	measure '% Tiempo SoC Bajo' = DIVIDE(SUM(fact_bateria_hora[seg_soc_bajo]), SUM(fact_bateria_hora[seg_obs]))
		formatString: 0.00%
		lineageTag: 6f80d3a4-097a-4e7c-9065-b2d5992298a3

	measure 'kWh Carga' = SUM(fact_bateria_hora[kwh_carga])
		formatString: #,0.0
		lineageTag: 283f9970-9c2c-4b01-936d-06ed9e1bf6e7

	measure 'kWh Descarga' = SUM(fact_bateria_hora[kwh_descarga])
		formatString: #,0.0
		lineageTag: 4f27b9fb-8eff-45d3-99c8-9b228807752b

	measure 'kWh PV' = SUM(fact_bateria_hora[kwh_pv])
		formatString: #,0.0
		lineageTag: fc1ee920-3b51-4297-bdf4-720883cb076c

	measure 'kWh Red' = SUM(fact_bateria_hora[kwh_red])
		formatString: #,0.0
		lineageTag: 3b858659-7232-4850-b899-14689d533ebc

	measure 'Eficiencia Ida y Vuelta' = DIVIDE([kWh Descarga], [kWh Carga] - SUM(fact_bateria_hora[delta_soc_kwh]))
		formatString: 0.000
		lineageTag: ea3773f4-dfb2-4d89-8bde-434fa3817c8a

	measure 'Ciclos Equivalentes' = DIVIDE([kWh Descarga], SELECTEDVALUE('Param Capacidad'[Capacidad kWh], 10.24) * DISTINCTCOUNT(fact_bateria_hora[inverter_id]))
		formatString: 0.0
		lineageTag: 357528ff-3965-4d59-86af-6afde8ab39f4

	measure 'Autosuficiencia %' = 1 - DIVIDE([kWh Red], SUM(fact_bateria_hora[kwh_carga_ac]))
		formatString: 0.0%
		lineageTag: b6930520-ae55-41a0-a7ec-c60661f12e7a

	measure 'Disponibilidad Registro' = DIVIDE(SUM(fact_bateria_hora[seg_obs]), SUM(fact_bateria_hora[seg_obs]) + SUM(fact_bateria_hora[seg_hueco]))
		formatString: 0.0%
		lineageTag: 28baf715-faa1-4238-8223-dd44ae80241a

	measure 'Ahorro COP' = [kWh Descarga] * SELECTEDVALUE('Param Tarifa'[Tarifa COP/kWh], 850)
		formatString: #,0
		lineageTag: 18d1d5bc-a346-4fc4-8d51-df754c60770d

	measure 'kWh Descarga Mes Anterior' = CALCULATE([kWh Descarga], DATEADD(dim_fecha[fecha], -1, MONTH))
		formatString: #,0.0
		lineageTag: 8f2230eb-ebbf-4d1d-8d4c-868a20872287

	measure 'Var kWh Descarga vs Mes Ant %' = DIVIDE([kWh Descarga] - [kWh Descarga Mes Anterior], [kWh Descarga Mes Anterior])
		formatString: 0.0%
		lineageTag: 94963e7c-42a4-407a-82f6-02bd7a21cc30

	measure 'kWh Descarga YTD' = TOTALYTD([kWh Descarga], dim_fecha[fecha])
		formatString: #,0.0
		lineageTag: 7c7215c0-7808-41d5-a8da-9aa7b020b8c8

