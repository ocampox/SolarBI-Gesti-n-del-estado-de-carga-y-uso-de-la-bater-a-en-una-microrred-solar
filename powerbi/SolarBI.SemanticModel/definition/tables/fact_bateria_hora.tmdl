		annotation UnderlyingDateTimeDataType = Date

	partition fact_bateria_hora = m
		mode: import
		source =
				let
					Origen = PostgreSQL.Database("localhost:5433", "solar_db"),
					T = Origen{[Schema="dw", Item="fact_bateria_hora"]}[Data],
					Fecha = Table.AddColumn(T, "fecha", each if Value.Is([hora_utc], type datetimezone) then Date.From(DateTimeZone.RemoveZone([hora_utc])) else Date.From([hora_utc]), type date)
				in
					Fecha

